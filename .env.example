# Cisco Business Dashboard base URL (no trailing slash)
CBD_BASE_URL=your_link_application

# Access key from Dashboard → Administration → Users → Generate Access Key
# Prefer a least-privilege / read-focused user for AI agents.
CBD_KEY_ID=your_access_key_id
CBD_KEY_SECRET=your_access_key_secret

# Optional: default organization context (x-ctx-org-id)
# CBD_ORG_ID=

# Optional: set to true if the Dashboard uses a private/self-signed certificate
# CBD_TLS_INSECURE=false

# Optional JWT identity claims
# CBD_APP_NAME=cisco-business-dashboard-mcp.local
# CBD_APP_VERSION=1.0.0
# CBD_CLIENT_ID=
# CBD_JWT_LIFETIME_SECONDS=3600
